5. import java.util.Scanner;

public class CrescimentoPopulacionalInterativo {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        char repetir;

        do {
            int populacaoA, populacaoB;
            double taxaA, taxaB;

            // Validação das populações
            do {
                System.out.print("Informe a população do país A (deve ser maior que 0): ");
                populacaoA = scanner.nextInt();

                System.out.print("Informe a população do país B (deve ser maior que 0): ");
                populacaoB = scanner.nextInt();

                if (populacaoA <= 0 || populacaoB <= 0) {
                    System.out.println("Erro: as populações devem ser maiores que zero.");
                } else if (populacaoA >= populacaoB) {
                    System.out.println("Erro: a população do país A deve ser menor que a do país B.");
                }
            } while (populacaoA <= 0 || populacaoB <= 0 || populacaoA >= populacaoB);

            // Validação das taxas
            do {
                System.out.print("Informe a taxa de crescimento anual do país A (em %): ");
                taxaA = scanner.nextDouble();

                System.out.print("Informe a taxa de crescimento anual do país B (em %): ");
                taxaB = scanner.nextDouble();

                if (taxaA <= 0 || taxaB <= 0) {
                    System.out.println("Erro: as taxas devem ser maiores que zero.");
                }
            } while (taxaA <= 0 || taxaB <= 0);

            int anos = 0;
            int a = populacaoA;
            int b = populacaoB;

            while (a <= b) {
                a += a * taxaA / 100;
                b += b * taxaB / 100;
                anos++;
            }

            System.out.println("\nSerá necessário " + anos + " ano(s) para que a população de A ultrapasse ou iguale a de B.");
            System.out.println("População final de A: " + a);
            System.out.println("População final de B: " + b);

            // Pergunta se deseja repetir
            System.out.print("\nDeseja repetir a operação? (s/n): ");
            repetir = scanner.next().toLowerCase().charAt(0);
            scanner.nextLine(); // Limpa o buffer

        } while (repetir == 's');

        scanner.close();
        System.out.println("Programa encerrado.");
    }
}

